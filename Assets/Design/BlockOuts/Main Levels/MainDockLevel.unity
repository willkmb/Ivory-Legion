--- !u!114 &2700701553783070245
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8293723574345083292}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a358a55889dccfc48b0c7a3ade9d7652, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DialogueSets:
  - Dialogues:
    - name: Bomilcar
      dialogueTextContent: Gisgo! Get a move on. We've got quotas to fill...
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices: []
    - name: Gisgo
      dialogueTextContent: Yeah, yeah. Coming!
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices: []
  - Dialogues:
    - name: Bomilcar
      dialogueTextContent: "What\u2019s with you today? Your trunk\u2019s practically
        dragging on the ground."
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices: []
    - name: Gisgo
      dialogueTextContent: It's... it's nothing.
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices: []
    - name: Bomilcar
      dialogueTextContent: Chin up, Gisgo. The wind is fresh and the sea is calm.
        Baal favours us this day.
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices: []
  - Dialogues:
    - name: Bomilcar
      dialogueTextContent: "I know it\u2019s been a busy morning Gisgo. We\u2019ve
        just got a bit more to do before the midday heat, then you can rest. Come."
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices: []
    - name: Bomilcar
      dialogueTextContent: Who put those there?! Go on Gisgo. Get that outta the
        way!
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices: []
  - Dialogues:
    - name: Bomilcar
      dialogueTextContent: Good job.
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices: []
  - Dialogues:
    - name: Bomilcar
      dialogueTextContent: "What are you playing at? You know you can take three
        at once. \u2018An efficient elephant is a...\u2019 "
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices: []
    - name: Gisgo
      dialogueTextContent: "\u2018Happy elephant\u2019. If you say so."
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices: []
    - name: Bomilcar
      dialogueTextContent: I do say so.
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices: []
    - name: Gisgo
      dialogueTextContent: ... Cut me some slack, man.
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices: []
  - Dialogues:
    - name: Bomilcar
      dialogueTextContent: "Oh for Baal\u2019s sake, I swear these docks get more
        broken every day."
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices:
      - choiceTextContent: '[Sarcastic]'
        choiceTopic: 
        nextBranch: 1
        rootBranch: 0
      - choiceTextContent: '[Defensive]'
        choiceTopic: 
        nextBranch: 2
        rootBranch: 0
    - name: Gisgo
      dialogueTextContent: "That\u2019s gonna cost an ear and a trunk."
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices:
      - choiceTextContent: Placeholder
        choiceTopic: 
        nextBranch: 3
        rootBranch: 1
    - name: Gisgo
      dialogueTextContent: "Don\u2019t even THINK about blaming me."
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices:
      - choiceTextContent: Placeholder
        choiceTopic: 
        nextBranch: 3
        rootBranch: 2
    - name: Bomilcar
      dialogueTextContent: "Don\u2019t even THINK about blaming me."
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices: []
  - Dialogues:
    - name: Gisgo
      dialogueTextContent: Just like yesterday. Just like tomorrow. And forever and
        ever.
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices: []
    - name: Bomilcar
      dialogueTextContent: It could be worse Gisgo. It could be worse.
      image: {fileID: 21300000, guid: 4f617a471b0b24842a3c263072c7dc2a, type: 3}
      choices: []
    - name: Gisgo
      dialogueTextContent: Gotta find mum and dad.
      image: {fileID: 21300000, guid: 326ca337f890b4a42bb8a4fd4b1c120d, type: 3}
      choices: []
  startIndex: 0
  branchIndex: 0
  speakerName: {fileID: 978814712}
  dialogueText: {fileID: 1099815906}
  dialogueBox: {fileID: 863151066}
  choiceRoot: {fileID: 1529864080}
  choiceButton: {fileID: 7364682090480881350, guid: 229068fa688c870419e0c55e7a1737a8, type: 3}
  cursorRoot: {fileID: 1269249353}
  cursor: {fileID: 3375012534551387402, guid: 99dcf58148a01714b854c2868d48dba2, type: 3}
