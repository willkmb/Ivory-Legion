--- !u!114 &238726311461892063
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4338218675179962841}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a358a55889dccfc48b0c7a3ade9d7652, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DialogueSets:
  - Dialogues:
    - name: Ozbaal
      dialogueTextContent: Bloody show off's. Come on son...
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Gisgo
      dialogueTextContent: But dad! I wanna watch!
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: "There\u2019ll be plenty more Elephant parades Gisgo."
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Gisgo
      dialogueTextContent: How could you possibly know that mum?!
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
  - Dialogues:
    - name: Gisgo
      dialogueTextContent: There you are! Mum, dad... I need to talk to you.
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: "Well done - using your little toesies for seismic sense.
        You\u2019re getting better every day."
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Gisgo
      dialogueTextContent: Muuuum!
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Ozbaal
      dialogueTextContent: Even I cringed.
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: He's just a boy.
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices:
      - choiceTextContent: '[Proud]'
        choiceTopic: 
        nextBranch: 5
        rootBranch: 4
        isBreaking: 0
        frequency: 0
        intensity: 0
      - choiceTextContent: '[Teasing]'
        choiceTopic: 
        nextBranch: 7
        rootBranch: 4
        isBreaking: 0
        frequency: 0
        intensity: 0
    - name: Gisgo
      dialogueTextContent: I have my adult tusks!
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: "There\u2019s more to maturity than size."
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 1
      nextBranch: 9
      choices: []
    - name: Gisgo
      dialogueTextContent: Beats being leathery and old.
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: "Gisgo! That\u2019s hurtful and rude!"
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 1
      nextBranch: 9
      choices: []
    - name: Ozbaal
      dialogueTextContent: Leave it alone. What did you want to ask us son?
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Gisgo
      dialogueTextContent: I... have you ever wanted to see the world?
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Ozbaal
      dialogueTextContent: No need. The world comes to us. Ships from Athens, Syracuse,
        Tyre... even Rome despite the... erm...
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: "What your father\u2019s saying is, the docks are all
        we need. Honest work. A good stable. Well fed and kept. Fresh air. We\u2019re
        a lucky herd."
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Gisgo
      dialogueTextContent: "What\u2019s the rest of Carthage like?"
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: "We don\u2019t know."
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Gisgo
      dialogueTextContent: What?! But...
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: Your father was born here - like you. I came from a logging
        camp outside.
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Gisgo
      dialogueTextContent: "I didn\u2019t know that. (Excited) What did it look like?
        Did you walk through Carthage?!"
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: "The logging camp was very green. And very loud. And I
        don\u2019t really remember Carthage."
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Gisgo
      dialogueTextContent: But elephants have good memories...
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
    - name: Zainab
      dialogueTextContent: "We do. But it\u2019s hard to remember details when you\u2019re
        sad. I\u2019d just left my parents."
      image: {fileID: 21300000, guid: 940387f2d7f8a404b8b160426215a9a5, type: 3}
      manualCursor: 0
      nextBranch: 0
      choices: []
  startIndex: 0
  branchIndex: 0
  speakerName: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueBox: {fileID: 0}
  choiceRoot: {fileID: 0}
  choiceButton: {fileID: 7364682090480881350, guid: 5c6420f137d0ed04db6c680c28e1dcb2, type: 3}
  cursorRoot: {fileID: 0}
  cursor: {fileID: 3375012534551387402, guid: dd30c2708ad35d54ea9cde22b423ce5b, type: 3}
